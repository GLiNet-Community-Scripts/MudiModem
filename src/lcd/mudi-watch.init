#!/bin/sh /etc/rc.common
# MudiUI toggle watcher — always-on. Listens for a long-press to switch between
# MudiUI and gl_screen. Never owns the framebuffer, so it coexists with both.

USE_PROCD=1
START=98        # before the UI service; it just needs to be listening
STOP=11

PROG=/usr/bin/mudi-watch.py
DEPS=/usr/sbin/mudimodem-lcddeps

start_service() {
    # Same post-FOTA guard as /etc/init.d/mudi — this one imports evdev. It is
    # worse here: respawn is `3600 5 0` (never give up), so a missing module
    # crash-loops forever, one traceback every 5s, until someone reads logread.
    if [ -x "$DEPS" ] && ! "$DEPS" check >/dev/null 2>&1; then
        logger -t mudi-watch "LCD python deps missing - deferring start to mudimodem-lcddeps heal"
        "$DEPS" heal >/dev/null 2>&1 &
        return 0
    fi

    procd_open_instance
    procd_set_param command python3 "$PROG"
    # hash $PROG into the instance config so procd respawns on a changed script;
    # see the same note in /etc/init.d/mudi.
    procd_set_param file "$PROG"
    procd_set_param respawn 3600 5 0     # always restart; it must always be listening
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
